const app = admin.initializeApp({
  credential: admin.cert({
    projectId: PROJECT_ID,
    clientEmail: CLIENT_EMAIL,
    privateKey: PRIVATE_KEY,
  }),
});
const db = getFirestore();
const auth = getAuth();
const now = Timestamp.now;

async function seed() {
  console.log(`Seeding production Firebase project: ${PROJECT_ID}\n`);

  // ── Auth: test users ──────────────────────────────────────────
  const users = [
    { uid: "admin-001", email: "admin@el-bannawy.app", password: "Admin@123", displayName: "Admin User", role: "admin" },
    { uid: "teacher-001", email: "teacher@el-bannawy.app", password: "Teacher@123", displayName: "Teacher User", role: "teacher" },
    { uid: "student-001", email: "student@el-bannawy.app", password: "Student@123", displayName: "Student User", role: "student" },
    { uid: "student-002", email: "student2@el-bannawy.app", password: "Student@123", displayName: "Student Two", role: "student" },
    { uid: "parent-001", email: "parent@el-bannawy.app", password: "Parent@123", displayName: "Parent User", role: "parent" },
  ];

  for (const u of users) {
    try {
      try { await auth.getUser(u.uid); console.log(`  ~ Auth user exists: ${u.email}`); continue; } catch {}
      await auth.createUser({ uid: u.uid, email: u.email, password: u.password, displayName: u.displayName });
      await auth.setCustomUserClaims(u.uid, { role: u.role });
      console.log(`  ✓ Auth user: ${u.email} (${u.role})`);
    } catch (err) {
      console.error(`  ✗ Auth user failed: ${u.email}`, err.message);
    }
  }

  // ── Firestore: users ─────────────────────────────────────────
  for (const u of users) {
    try {
      const ref = db.collection("users").doc(u.uid);
      if ((await ref.get()).exists) { console.log(`  ~ Firestore user exists: ${u.email}`); continue; }
      await ref.set({
        email: u.email,
        fullName: u.displayName,
        mobileNumber: u.uid === "student-001" ? "01000000001" : u.uid === "student-002" ? "01000000002" : null,
        role: u.role,
        status: "active",
        createdAt: now(),
        updatedAt: now(),
      });
      console.log(`  ✓ Firestore user: ${u.email}`);
    } catch (err) { console.error(`  ✗ Firestore user: ${u.email}`, err.message); }
  }

  // ── Educational System ────────────────────────────────────────
  const eduSysId = "egypt-national";
  const eduSysRef = db.collection("educationalSystems").doc(eduSysId);
  if (!(await eduSysRef.get()).exists) {
    await eduSysRef.set({ name: "Egypt National Curriculum", nameAr: "المنهج المصري", isActive: true, createdAt: now(), updatedAt: now(), schemaVersion: 1, deletedAt: null });
    console.log("  ✓ educationalSystems/egypt-national");
  } else { console.log("  ~ educationalSystems/egypt-national exists"); }

  // ── Stages ────────────────────────────────────────────────────
  const stages = [
    { id: "stage-primary", name: "Primary", nameAr: "المرحلة الابتدائية", order: 1 },
    { id: "stage-preparatory", name: "Preparatory", nameAr: "المرحلة الإعدادية", order: 2 },
    { id: "stage-secondary", name: "Secondary", nameAr: "المرحلة الثانوية", order: 3 },
  ];
  for (const s of stages) {
    const ref = db.collection("stages").doc(s.id);
    if (!(await ref.get()).exists) {
      await ref.set({ educationalSystemId: eduSysId, name: s.name, nameAr: s.nameAr, order: s.order, isActive: true, createdAt: now(), updatedAt: now(), schemaVersion: 1, deletedAt: null });
      console.log(`  ✓ stages/${s.id}`);
    } else { console.log(`  ~ stages/${s.id} exists`); }
  }

  // ── Grades ────────────────────────────────────────────────────
  const grades = [
    { id: "grade-1", name: "Grade 1", nameAr: "الصف الأول", stageId: "stage-primary", order: 1 },
    { id: "grade-2", name: "Grade 2", nameAr: "الصف الثاني", stageId: "stage-primary", order: 2 },
    { id: "grade-3", name: "Grade 3", nameAr: "الصف الثالث", stageId: "stage-primary", order: 3 },
    { id: "grade-4", name: "Grade 4", nameAr: "الصف الرابع", stageId: "stage-primary", order: 4 },
    { id: "grade-5", name: "Grade 5", nameAr: "الصف الخامس", stageId: "stage-primary", order: 5 },
    { id: "grade-6", name: "Grade 6", nameAr: "الصف السادس", stageId: "stage-primary", order: 6 },
    { id: "grade-7", name: "Grade 7", nameAr: "الصف الأول الإعدادي", stageId: "stage-preparatory", order: 7 },
    { id: "grade-8", name: "Grade 8", nameAr: "الصف الثاني الإعدادي", stageId: "stage-preparatory", order: 8 },
    { id: "grade-9", name: "Grade 9", nameAr: "الصف الثالث الإعدادي", stageId: "stage-preparatory", order: 9 },
    { id: "grade-10", name: "Grade 10", nameAr: "الصف الأول الثانوي", stageId: "stage-secondary", order: 10 },
    { id: "grade-11", name: "Grade 11", nameAr: "الصف الثاني الثانوي", stageId: "stage-secondary", order: 11 },
    { id: "grade-12", name: "Grade 12", nameAr: "الصف الثالث الثانوي", stageId: "stage-secondary", order: 12 },
  ];
  for (const g of grades) {
    const ref = db.collection("grades").doc(g.id);
    if (!(await ref.get()).exists) {
      await ref.set({ educationalSystemId: eduSysId, stageId: g.stageId, name: g.name, nameAr: g.nameAr, order: g.order, isActive: true, createdAt: now(), updatedAt: now(), schemaVersion: 1, deletedAt: null });
      console.log(`  ✓ grades/${g.id}`);
    } else { console.log(`  ~ grades/${g.id} exists`); }
  }

  // ── Academic Year ────────────────────────────────────────────
  const ayId = "ay-2025-2026";
  const ayRef = db.collection("academicYears").doc(ayId);
  if (!(await ayRef.get()).exists) {
    await ayRef.set({ educationalSystemId: eduSysId, name: "2025/2026", nameAr: "2025/2026", startDate: "2025-09-01", endDate: "2026-06-30", isCurrent: true, isActive: true, createdAt: now(), updatedAt: now(), schemaVersion: 1, deletedAt: null });
    console.log("  ✓ academicYears/ay-2025-2026");
  } else { console.log("  ~ academicYears/ay-2025-2026 exists"); }

  // ── Academic Terms ────────────────────────────────────────────
  const terms = [
    { id: "term-1", name: "First Term", nameAr: "الفصل الدراسي الأول", order: 1, startDate: "2025-09-01", endDate: "2026-01-15", isCurrent: true },
    { id: "term-2", name: "Second Term", nameAr: "الفصل الدراسي الثاني", order: 2, startDate: "2026-02-01", endDate: "2026-06-30", isCurrent: false },
  ];
  for (const t of terms) {
    const ref = db.collection("academicTerms").doc(t.id);
    if (!(await ref.get()).exists) {
      await ref.set({ academicYearId: ayId, name: t.name, nameAr: t.nameAr, order: t.order, startDate: t.startDate, endDate: t.endDate, isCurrent: t.isCurrent, isActive: true, createdAt: now(), updatedAt: now(), schemaVersion: 1, deletedAt: null });
      console.log(`  ✓ academicTerms/${t.id}`);
    } else { console.log(`  ~ academicTerms/${t.id} exists`); }
  }

  // ── Units ─────────────────────────────────────────────────────
  const units = [
    { id: "unit-1", name: "Unit 1: Hello!", nameAr: "الوحدة الأولى: مرحباً!", order: 1, isPremium: false, published: true },
    { id: "unit-2", name: "Unit 2: My Family", nameAr: "الوحدة الثانية: عائلتي", order: 2, isPremium: false, published: true },
    { id: "unit-3", name: "Unit 3: School", nameAr: "الوحدة الثالثة: المدرسة", order: 3, isPremium: false, published: true },
    { id: "unit-4", name: "Unit 4: Daily Life", nameAr: "الوحدة الرابعة: الحياة اليومية", order: 4, isPremium: false, published: true },
    { id: "unit-5", name: "Unit 5: Food & Drink", nameAr: "الوحدة الخامسة: الطعام والشراب", order: 5, isPremium: true, published: true },
  ];
  for (const u of units) {
    const ref = db.collection("units").doc(u.id);
    if (!(await ref.get()).exists) {
      await ref.set({ academicTermId: "term-1", name: u.name, nameAr: u.nameAr, description: u.name, order: u.order, isActive: true, isPremium: u.isPremium, published: u.published, createdAt: now(), updatedAt: now(), schemaVersion: 1, deletedAt: null });
      console.log(`  ✓ units/${u.id}`);
    } else { console.log(`  ~ units/${u.id} exists`); }
  }

  // ── Lessons ───────────────────────────────────────────────────
  let lessonCount = 0;
  const lessonData = [];
  for (const u of units) {
    for (let i = 1; i <= 3; i++) {
      const lid = `lesson-${u.id}-${i}`;
      lessonData.push({ id: lid, unitId: u.id, title: `${u.name} - Lesson ${i}`, slug: `${u.id}-lesson-${i}`, displayOrder: i, status: "published", isPublished: true, estimatedDuration: 30 });
    }
  }
  for (const l of lessonData) {
    const ref = db.collection("lessons").doc(l.id);
    if (!(await ref.get()).exists) {
      await ref.set({ unitId: l.unitId, title: l.title, slug: l.slug, displayOrder: l.displayOrder, status: l.status, isPublished: l.isPublished, isVisible: true, estimatedDuration: l.estimatedDuration, createdAt: now(), updatedAt: now(), schemaVersion: 1, deletedAt: null });
      lessonCount++;
    }
  }
  console.log(`  ✓ lessons: ${lessonCount} new, others exist`);

  // ── Activities ────────────────────────────────────────────────
  let activityCount = 0;
  const activityTypes = ["multiple-choice", "fill-in-blank", "matching", "true-false", "drag-drop"];
  for (const l of lessonData) {
    for (let i = 0; i < 2; i++) {
      const aid = `act-${l.id}-${i}`;
      const ref = db.collection("activities").doc(aid);
      if (!(await ref.get()).exists) {
        const atype = activityTypes[(lessonData.indexOf(l) + i) % activityTypes.length];
        await ref.set({
          lessonId: l.id,
          type: atype,
          title: `Activity ${i + 1} for ${l.title}`,
          displayOrder: i + 1,
          status: "published",
          isRequired: true,
          isScorable: true,
          isPractice: false,
          retryable: true,
          maxAttempts: 3,
          timeLimit: null,
          prerequisiteActivityIds: [],
          config: { schemaVersion: 1, data: { prompt: "Sample question?", options: ["A", "B", "C", "D"], correctIndex: 0 } },
          metadata: { estimatedDuration: 5, difficulty: "easy", tags: [], aiGenerated: false },
          createdAt: now(), updatedAt: now(), schemaVersion: 1, deletedAt: null,
        });
        activityCount++;
      }
    }
  }
  console.log(`  ✓ activities: ${activityCount} new, others exist`);

  // ── Homework & Quiz (one each for first 5 lessons) ────────────
  let hwCount = 0, qzCount = 0;
  for (const l of lessonData.slice(0, 5)) {
    const hwRef = db.collection("homework").doc(`hw-${l.id}`);
    if (!(await hwRef.get()).exists) {
      await hwRef.set({ lessonId: l.id, title: `Homework: ${l.title}`, description: "Complete the homework", isPublished: true, dueDaysOffset: 3, maxAttempts: 2, createdAt: now(), updatedAt: now(), schemaVersion: 1, deletedAt: null });
      hwCount++;
    }
    const qzRef = db.collection("quizzes").doc(`qz-${l.id}`);
    if (!(await qzRef.get()).exists) {
      await qzRef.set({ lessonId: l.id, title: `Quiz: ${l.title}`, description: "Test your knowledge", isPublished: true, maxAttempts: 2, timeLimitMinutes: 15, passingScore: 60, createdAt: now(), updatedAt: now(), schemaVersion: 1, deletedAt: null });
      qzCount++;
    }
  }
  console.log(`  ✓ homework: ${hwCount} new, others exist`);
  console.log(`  ✓ quizzes: ${qzCount} new, others exist`);

  // ── Achievements ─────────────────────────────────────────────
  const achievements = [
    { id: "first-lesson", name: "First Lesson", nameAr: "أول درس", description: "Complete your first lesson", icon: "star", xpReward: 50 },
    { id: "perfect-quiz", name: "Perfect Quiz", nameAr: "اختبار مثالي", description: "Get 100% on a quiz", icon: "trophy", xpReward: 100 },
    { id: "streak-7", name: "7-Day Streak", nameAr: "تحدي 7 أيام", description: "Study for 7 days in a row", icon: "flame", xpReward: 200 },
  ];
  for (const a of achievements) {
    const ref = db.collection("achievements").doc(a.id);
    if (!(await ref.get()).exists) {
      await ref.set({ code: a.id, name: a.name, nameAr: a.nameAr, description: a.description, icon: a.icon, xpReward: a.xpReward, active: true, createdAt: now() });
      console.log(`  ✓ achievements/${a.id}`);
    } else { console.log(`  ~ achievements/${a.id} exists`); }
  }

  // ── Stories ──────────────────────────────────────────────────
  const stories = [
    { id: "story-1", title: "The Brave Little Boy", titleAr: "الصبي الشجاع", gradeId: "grade-1", displayOrder: 1, published: true },
    { id: "story-2", title: "The Clever Rabbit", titleAr: "الأرنب الذكي", gradeId: "grade-1", displayOrder: 2, published: true },
  ];
  for (const s of stories) {
    const ref = db.collection("stories").doc(s.id);
    if (!(await ref.get()).exists) {
      await ref.set({ title: s.title, titleAr: s.titleAr, gradeId: s.gradeId, displayOrder: s.displayOrder, published: s.published, createdAt: now(), updatedAt: now() });
      console.log(`  ✓ stories/${s.id}`);
    } else { console.log(`  ~ stories/${s.id} exists`); }
  }

  // ── System Settings ──────────────────────────────────────────
  const sysRef = db.collection("systemSettings").doc("platform");
  if (!(await sysRef.get()).exists) {
    await sysRef.set({ name: "El-bannawy Platform", defaultLanguage: "ar", supportedLanguages: ["ar", "en"], maintenanceMode: false, maxLoginAttempts: 5, sessionTimeoutMinutes: 60, createdAt: now() });
    console.log("  ✓ systemSettings/platform");
  } else { console.log("  ~ systemSettings/platform exists"); }

  // ── Feature Flags ────────────────────────────────────────────
  const ffRef = db.collection("featureFlags").doc("public");
  if (!(await ffRef.get()).exists) {
    await ffRef.set({ newDashboard: true, aiTutor: false, liveClasses: false, gamification: true, updatedAt: now() });
    console.log("  ✓ featureFlags/public");
  } else { console.log("  ~ featureFlags/public exists"); }

  // ── XP & Wallet for student-001 ───────────────────────────────
  const xpRef = db.collection("xpAccounts").doc("student-001");
  if (!(await xpRef.get()).exists) {
    await xpRef.set({ userId: "student-001", totalXp: 150, level: 2, createdAt: now(), updatedAt: now() });
    console.log("  ✓ xpAccounts/student-001");
  } else { console.log("  ~ xpAccounts/student-001 exists"); }

  const walletRef = db.collection("wallets").doc("student-001");
  if (!(await walletRef.get()).exists) {
    await walletRef.set({ userId: "student-001", coins: 500, createdAt: now(), updatedAt: now() });
    console.log("  ✓ wallets/student-001");
  } else { console.log("  ~ wallets/student-001 exists"); }

  const statsRef = db.collection("studentStats").doc("student-001");
  if (!(await statsRef.get()).exists) {
    await statsRef.set({ userId: "student-001", lessonsCompleted: 2, quizzesPassed: 1, streakDays: 3, lastActiveDate: new Date().toISOString().split("T")[0], createdAt: now(), updatedAt: now() });
    console.log("  ✓ studentStats/student-001");
  } else { console.log("  ~ studentStats/student-001 exists"); }

  // ── Courses ──────────────────────────────────────────────────
  const courses = [
    { id: "course-primary-english-1", name: "English Grade 1 - Term 1", nameAr: "اللغة الإنجليزية الصف الأول - الترم الأول", gradeId: "grade-1", academicTermId: "term-1", order: 1 },
    { id: "course-primary-english-2", name: "English Grade 2 - Term 1", nameAr: "اللغة الإنجليزية الصف الثاني - الترم الأول", gradeId: "grade-2", academicTermId: "term-1", order: 2 },
  ];
  let courseCreated = 0;
  for (const c of courses) {
    const ref = db.collection("courses").doc(c.id);
    if (!(await ref.get()).exists) {
      await ref.set(c);
      courseCreated++;
      console.log(`  ✓ courses/${c.id}`);
    } else { console.log(`  ~ courses/${c.id} exists`); }
  }

  // ── Enrollments ──────────────────────────────────────────────
  const enrollments = [
    { id: "enroll-student-001-course-primary-english-1", userId: "student-001", courseId: "course-primary-english-1", status: "active", enrolledAt: now() },
    { id: "enroll-student-002-course-primary-english-1", userId: "student-002", courseId: "course-primary-english-1", status: "active", enrolledAt: now() },
  ];
  for (const e of enrollments) {
    const ref = db.collection("enrollments").doc(e.id);
    if (!(await ref.get()).exists) {
      await ref.set(e);
      console.log(`  ✓ enrollments/${e.id}`);
    } else { console.log(`  ~ enrollments/${e.id} exists`); }
  }

  // ── Teacher Assignments ──────────────────────────────────────
  const assignments = [
    { id: "assign-teacher-course-primary-english-1", userId: "teacher-001", courseId: "course-primary-english-1", role: "teacher", assignedAt: now() },
  ];
  for (const a of assignments) {
    const ref = db.collection("teacherAssignments").doc(a.id);
    if (!(await ref.get()).exists) {
      await ref.set(a);
      console.log(`  ✓ teacherAssignments/${a.id}`);
    } else { console.log(`  ~ teacherAssignments/${a.id} exists`); }
  }

  console.log("\n✅ Seeding complete!");
  console.log("\nTest accounts:");
  console.log("  Admin:   admin@el-bannawy.app / Admin@123");
  console.log("  Teacher: teacher@el-bannawy.app / Teacher@123");
  console.log("  Student: student@el-bannawy.app / Student@123");
  console.log("  Parent:  parent@el-bannawy.app / Parent@123");

  await app.delete();
}

seed().catch((err) => {
  console.error("Seeding failed:", err);
  process.exit(1);
});
