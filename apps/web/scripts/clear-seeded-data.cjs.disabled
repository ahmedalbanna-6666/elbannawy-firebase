const db = getFirestore();
const auth = getAuth();

const SEEDED_IDS = {
  users: ["admin-001", "teacher-001", "student-001", "student-002", "parent-001"],
  educationalSystems: ["egypt-national"],
  stages: ["stage-primary", "stage-preparatory", "stage-secondary"],
  grades: ["grade-1", "grade-2", "grade-3", "grade-4", "grade-5", "grade-6", "grade-7", "grade-8", "grade-9", "grade-10", "grade-11", "grade-12"],
  academicYears: ["ay-2025-2026"],
  academicTerms: ["term-1", "term-2"],
  units: ["unit-1", "unit-2", "unit-3", "unit-4", "unit-5"],
  lessons: [
    "lesson-unit-1-1", "lesson-unit-1-2", "lesson-unit-1-3",
    "lesson-unit-2-1", "lesson-unit-2-2", "lesson-unit-2-3",
    "lesson-unit-3-1", "lesson-unit-3-2", "lesson-unit-3-3",
    "lesson-unit-4-1", "lesson-unit-4-2", "lesson-unit-4-3",
    "lesson-unit-5-1", "lesson-unit-5-2", "lesson-unit-5-3",
  ],
  activities: [
    "act-lesson-unit-1-1-0", "act-lesson-unit-1-1-1",
    "act-lesson-unit-1-2-0", "act-lesson-unit-1-2-1",
    "act-lesson-unit-1-3-0", "act-lesson-unit-1-3-1",
    "act-lesson-unit-2-1-0", "act-lesson-unit-2-1-1",
    "act-lesson-unit-2-2-0", "act-lesson-unit-2-2-1",
    "act-lesson-unit-2-3-0", "act-lesson-unit-2-3-1",
    "act-lesson-unit-3-1-0", "act-lesson-unit-3-1-1",
    "act-lesson-unit-3-2-0", "act-lesson-unit-3-2-1",
    "act-lesson-unit-3-3-0", "act-lesson-unit-3-3-1",
    "act-lesson-unit-4-1-0", "act-lesson-unit-4-1-1",
    "act-lesson-unit-4-2-0", "act-lesson-unit-4-2-1",
    "act-lesson-unit-4-3-0", "act-lesson-unit-4-3-1",
    "act-lesson-unit-5-1-0", "act-lesson-unit-5-1-1",
    "act-lesson-unit-5-2-0", "act-lesson-unit-5-2-1",
    "act-lesson-unit-5-3-0", "act-lesson-unit-5-3-1",
  ],
  homework: ["hw-lesson-unit-1-1", "hw-lesson-unit-1-2", "hw-lesson-unit-1-3", "hw-lesson-unit-2-1", "hw-lesson-unit-2-2"],
  quizzes: ["qz-lesson-unit-1-1", "qz-lesson-unit-1-2", "qz-lesson-unit-1-3", "qz-lesson-unit-2-1", "qz-lesson-unit-2-2"],
  achievements: ["first-lesson", "perfect-quiz", "streak-7"],
  stories: ["story-1", "story-2"],
  systemSettings: ["platform"],
  featureFlags: ["public"],
  xpAccounts: ["student-001"],
  wallets: ["student-001"],
  studentStats: ["student-001"],
  courses: ["course-primary-english-1", "course-primary-english-2"],
  enrollments: ["enroll-student-001-course-primary-english-1", "enroll-student-002-course-primary-english-1"],
  teacherAssignments: ["assign-teacher-course-primary-english-1"],
};

async function clearData() {
  console.log(`Clearing seeded data from Firebase project: ${PROJECT_ID}\n`);

  // ── Clear Firestore documents ─────────────────────────────────
  let deletedCount = 0;
  for (const [collection, ids] of Object.entries(SEEDED_IDS)) {
    for (const id of ids) {
      try {
        const ref = db.collection(collection).doc(id);
        const snap = await ref.get();
        if (snap.exists) {
          await ref.delete();
          deletedCount++;
          console.log(`  ✓ Deleted ${collection}/${id}`);
        }
      } catch (err) {
        console.error(`  ✗ Failed to delete ${collection}/${id}:`, err.message);
      }
    }
  }
  console.log(`\n  Deleted ${deletedCount} Firestore documents`);

  // ── Delete Auth users ─────────────────────────────────────────
  let authDeleted = 0;
  for (const uid of SEEDED_IDS.users) {
    try {
      await auth.getUser(uid);
      await auth.deleteUser(uid);
      authDeleted++;
      console.log(`  ✓ Deleted Auth user: ${uid}`);
    } catch (err) {
      if (err.code !== "auth/user-not-found") {
        console.error(`  ✗ Failed to delete Auth user ${uid}:`, err.message);
      }
    }
  }
  console.log(`\n  Deleted ${authDeleted} Auth users`);

  console.log("\n✅ Seeded data cleared!");
  await app.delete();
}

clearData().catch((err) => {
  console.error("Cleanup failed:", err);
  process.exit(1);
});
