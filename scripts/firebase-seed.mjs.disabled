#!/usr/bin/env node

import { createRequire } from "module";
import { resolve, dirname } from "path";
import { fileURLToPath } from "url";

const __dirname = dirname(fileURLToPath(import.meta.url));
const require = createRequire(resolve(__dirname, "..", "apps", "web"));

const admin = require("firebase-admin");

process.env.FIRESTORE_EMULATOR_HOST = "localhost:8080";
process.env.FIREBASE_AUTH_EMULATOR_HOST = "localhost:9099";
process.env.FIREBASE_STORAGE_EMULATOR_HOST = "localhost:9199";
process.env.GCLOUD_PROJECT = "el-bannawy-dev";

const app = admin.initializeApp({ projectId: "el-bannawy-dev" });
const auth = admin.auth();
const db = admin.firestore();
db.settings({ host: "localhost:8080", ssl: false });

async function seed() {
  console.log("Seeding Firebase emulators...\n");

  // ── Auth: test users ──────────────────────────────────────────
  const users = [
    { uid: "admin-001", email: "admin@el-bannawy.app", password: "Admin@123", displayName: "Admin User", role: "admin" },
    { uid: "teacher-001", email: "teacher@el-bannawy.app", password: "Teacher@123", displayName: "Teacher User", role: "teacher" },
    { uid: "student-001", email: "student@el-bannawy.app", password: "Student@123", displayName: "Student User", role: "student" },
    { uid: "student-002", email: "student2@el-bannawy.app", password: "Student@123", displayName: "Student Two", role: "student" },
    { uid: "parent-001", email: "parent@el-bannawy.app", password: "Parent@123", displayName: "Parent User", role: "parent" },
  ];

  for (const u of users) {
    try {
      await auth.createUser({
        uid: u.uid,
        email: u.email,
        password: u.password,
        displayName: u.displayName,
      });
      await auth.setCustomUserClaims(u.uid, { role: u.role, isAdmin: u.role === "admin", isTeacher: u.role === "teacher" });
      console.log(`  ✓ Auth user: ${u.email} (${u.role})`);
    } catch (err) {
      if (err.code === "auth/uid-already-exists") {
        console.log(`  ~ Auth user exists: ${u.email}`);
      } else {
        console.error(`  ✗ Auth user failed: ${u.email}`, err.message);
      }
    }
  }

  // ── Firestore: user documents ─────────────────────────────────
  const userDocs = users.map((u) => ({
    objectMap: {
      id: u.uid,
      email: u.email,
      fullName: u.displayName,
      mobileNumber: u.uid === "student-001" ? "01000000001" : u.uid === "student-002" ? "01000000002" : null,
      role: u.role,
      status: "active",
      createdAt: admin.firestore.FieldValue.serverTimestamp(),
      updatedAt: admin.firestore.FieldValue.serverTimestamp(),
    },
  }));

  const userRef = db.collection("users");
  for (const u of users) {
    try {
      await userRef.doc(u.uid).set({
        email: u.email,
        fullName: u.displayName,
        mobileNumber: u.uid === "student-001" ? "01000000001" : u.uid === "student-002" ? "01000000002" : null,
        role: u.role,
        status: "active",
        createdAt: admin.firestore.FieldValue.serverTimestamp(),
        updatedAt: admin.firestore.FieldValue.serverTimestamp(),
      });
      console.log(`  ✓ Firestore user: ${u.email}`);
    } catch (err) {
      console.error(`  ✗ Firestore user failed: ${u.email}`, err.message);
    }
  }

  // ── Firestore: educational system ────────────────────────────
  const eduSysRef = db.collection("educationalSystems");
  const eduSys = {
    id: "egypt-national",
    name: "Egypt National Curriculum",
    nameAr: "المنهج المصري",
    stages: ["primary", "preparatory", "secondary"],
    createdAt: admin.firestore.FieldValue.serverTimestamp(),
  };
  await eduSysRef.doc("egypt-national").set(eduSys);
  console.log("  ✓ Firestore: educationalSystems/egypt-national");

  // ── Firestore: grades for primary ────────────────────────────
  const gradesRef = db.collection("grades");
  const grades = [
    { id: "grade-1", name: "Grade 1", nameAr: "الصف الأول", educationalSystemId: "egypt-national", stage: "primary", order: 1 },
    { id: "grade-2", name: "Grade 2", nameAr: "الصف الثاني", educationalSystemId: "egypt-national", stage: "primary", order: 2 },
    { id: "grade-3", name: "Grade 3", nameAr: "الصف الثالث", educationalSystemId: "egypt-national", stage: "primary", order: 3 },
  ];
  for (const g of grades) {
    await gradesRef.doc(g.id).set({ ...g, createdAt: admin.firestore.FieldValue.serverTimestamp() });
  }
  console.log("  ✓ Firestore: grades (3 documents)");

  // ── Firestore: academic year ─────────────────────────────────
  const academicYearRef = db.collection("academicYears");
  await academicYearRef.doc("ay-2025-2026").set({
    id: "ay-2025-2026",
    name: "2025-2026 Academic Year",
    nameAr: "العام الدراسي 2025-2026",
    startDate: "2025-09-01",
    endDate: "2026-06-30",
    isCurrent: true,
    createdAt: admin.firestore.FieldValue.serverTimestamp(),
  });
  console.log("  ✓ Firestore: academicYears/ay-2025-2026");

  // ── Firestore: system settings ───────────────────────────────
  await db.collection("systemSettings").doc("platform").set({
    name: "El-bannawy Platform",
    defaultLanguage: "ar",
    supportedLanguages: ["ar", "en"],
    maintenanceMode: false,
    maxLoginAttempts: 5,
    sessionTimeoutMinutes: 60,
    createdAt: admin.firestore.FieldValue.serverTimestamp(),
  });
  console.log("  ✓ Firestore: systemSettings/platform");

  // ── Firestore: feature flags ─────────────────────────────────
  await db.collection("featureFlags").doc("public").set({
    newDashboard: true,
    aiTutor: false,
    liveClasses: false,
    gamification: true,
    updatedAt: admin.firestore.FieldValue.serverTimestamp(),
  });
  console.log("  ✓ Firestore: featureFlags/public");

  console.log("\n✅ Seeding complete!");
  console.log("\nTest accounts:");
  console.log("  Admin:   admin@el-bannawy.app / Admin@123");
  console.log("  Teacher: teacher@el-bannawy.app / Teacher@123");
  console.log("  Student: student@el-bannawy.app / Student@123");
  console.log("  Parent:  parent@el-bannawy.app / Parent@123");

  await app.delete();
}

seed().catch((err) => {
  console.error("Seeding failed:", err);
  process.exit(1);
});
