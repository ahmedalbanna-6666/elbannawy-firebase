rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.role == "admin";
    }
    function isTeacher() {
      return request.auth != null && (
        request.auth.token.role == "teacher" ||
        request.auth.token.role == "admin"
      );
    }
    function isSupport() {
      return request.auth != null && (
        request.auth.token.role == "support" ||
        request.auth.token.role == "admin"
      );
    }

    // ── User documents ──────────────────────────────────────────
    // Protected fields (academic assignments) are write-only via API (Admin SDK).
    // Students must NOT be able to modify their own gradeId, stageId, etc. from the client.
    function userProtectedFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'gradeId', 'stageId', 'educationalSystemId', 'academicYearId', 'termId'
      ]);
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && (!userProtectedFieldsChanged() || isAdmin());
      allow delete: if false;
    }

    // ── Educational system (static data from code constants) ────
    match /educationalSystems/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /stages/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /grades/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /academicYears/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /terms/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Curriculum ──────────────────────────────────────────────
    match /books/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /units/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /lessons/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /lessonVideos/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /activities/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /answerKeys/{doc} {
      allow read: if isTeacher();
      allow write: if isAdmin();
    }

    // ── Student progress (owner only) ───────────────────────────
    match /lessonProgress/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /videoProgress/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /activityProgress/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /studentStats/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ── Homework & Quiz attempts ────────────────────────────────
    match /homeworkAttempts/{doc} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isTeacher()
      );
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /quizAttempts/{doc} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isTeacher()
      );
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ── Gamification ────────────────────────────────────────────
    match /xpAccounts/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /achievements/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /userAchievements/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ── Payments & Wallet ───────────────────────────────────────
    match /wallets/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    match /payments/{doc} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    match /invoices/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if isAdmin();
    }

    // ── Notifications ───────────────────────────────────────────
    match /notificationPreferences/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /notifications/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if isAdmin();
    }

    match /deviceTokens/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ── AI ──────────────────────────────────────────────────────
    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId;
      }
    }

    match /aiAssessments/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ── Support ─────────────────────────────────────────────────
    match /supportTickets/{ticketId} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        isAdmin()
      );
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid == get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.userId ||
          isAdmin()
        );
        allow write: if request.auth != null;
      }
    }

    // ── Administration ──────────────────────────────────────────
    match /systemSettings/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /featureFlags/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /auditLogs/{doc} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ── Referrals ───────────────────────────────────────────────
    match /referralProfiles/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    match /referralPolicies/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── Live Classes ────────────────────────────────────────────
    match /liveSessions/{doc} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
    match /liveBookings/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.studentId;
      allow write: if request.auth != null && request.auth.uid == resource.data.studentId;
    }
    match /teacherAvailability/{doc} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
    match /teacherDateBlocks/{doc} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
    match /liveAttendance/{doc} {
      allow read: if isTeacher();
      allow write: if isTeacher();
    }
    match /liveAnnouncements/{doc} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
    match /liveSessionSecrets/{doc} {
      allow read, write: if isAdmin();
    }

    // ── Stories ─────────────────────────────────────────────────
    match /stories/{doc} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
    match /storyChapters/{doc} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
    match /storyLessons/{doc} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
    match /storyProgress/{doc} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.studentId;
    }

    // ── Final Reviews ───────────────────────────────────────────
    match /finalReviews/{doc} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
    match /finalReviewUnits/{doc} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /finalReviewLessons/{doc} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /finalReviewQuestions/{doc} { allow read: if request.auth != null; allow write: if isAdmin(); }
    match /finalReviewAttempts/{doc} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.studentId || isTeacher());
      allow write: if request.auth != null && request.auth.uid == resource.data.studentId;
    }
    match /finalReviewAnswers/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.studentId;
      allow write: if request.auth != null && request.auth.uid == resource.data.studentId;
    }

    // ── Competitions ────────────────────────────────────────────
    match /competitions/{doc} {
      allow read: if request.auth != null;
      allow write: if isTeacher();
    }
    match /competitionParticipants/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == resource.data.studentId || isTeacher());
    }
    match /competitionQuestions/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /competitionAttempts/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.studentId;
      allow write: if request.auth != null && request.auth.uid == resource.data.studentId;
    }

    // ── Coins & Wallet ──────────────────────────────────────────
    match /coinTransactions/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.studentId;
      allow write: if false;
    }
    match /coinPackages/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /contentEntitlements/{doc} {
      allow read: if request.auth != null && request.auth.uid == resource.data.studentId;
      allow write: if false;
    }

    match /coupons/{doc} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /coinPurchaseRequests/{doc} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.studentId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == request.resource.data.studentId;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Grade Support Contacts ──────────────────────────────────
    match /gradeSupportContacts/{doc} {
      allow read: if request.auth != null;
      allow write: if isSupport();
    }

    // ── Default deny ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}